{
  "name": "whatscart-migration",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "contract:capture": "node scripts/capture-source-contract.mjs ../whatsCartNew contracts/source-contract.json",
    "contract:verify-ui": "node scripts/verify-ui-contract.mjs . contracts/source-contract.json",
    "firebase:emulators": "npx --yes firebase-tools@15.4.0 emulators:start --project demo-whatscart",
    "firebase:emulators:exec": "npx --yes firebase-tools@15.4.0 emulators:exec --project demo-whatscart",
    "vercel:dev": "npx --yes vercel@59.1.3 dev",
    "vercel:pull": "npx --yes vercel@59.1.3 env pull .env.local",
    "vercel:preview": "npx --yes vercel@59.1.3 deploy",
    "vercel:production": "npx --yes vercel@59.1.3 deploy --prod"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^5.5.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.12.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "~10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "~8.5.6",
    "tailwindcss": "~3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
