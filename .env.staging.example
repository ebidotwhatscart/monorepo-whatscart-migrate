# Staging domain and Firebase project
NEXT_PUBLIC_ROOT_DOMAIN=bhuvanadotk.in
NEXT_PUBLIC_APP_URL=https://app.bhuvanadotk.in

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=whatscart-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=whatscart-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=whatscart-dev-uploads
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Bubblewrap/Gradle uses this host for the staging TWA.
TWA_HOST=app.bhuvanadotk.in
ANDROID_TWA_SHA256_CERT_FINGERPRINT=

# Keep emulators disabled when testing against the staging Firebase project.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Firebase Admin credentials for the staging server; do not commit values.
FIREBASE_PROJECT_ID=whatscart-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=whatscart-dev-uploads
FIREBASE_UPLOAD_SECRET=
